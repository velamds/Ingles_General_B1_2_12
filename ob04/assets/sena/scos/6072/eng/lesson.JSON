rride": 2}, {"id": 11, "stimuli_ids": [], "questions": [{"_data": [{"type": "question", "contents": [{"content": "", "type": "text"}]}], "responses": [{"id": 0, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 0}, {"id": 1, "selected": 0, "_data": [{"content": "", "type": "text"}], "correct": 1}], "id": 0}], "_data": [{"type": "instructions", "contents": []}, {"type": "group", "contents": [{"content": "Quiz", "type": "group_name"}]}, {"content": {"correct_feedback": "Correct!", "allowed_attempts": 2, "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "incorrect_feedback": [{"content": "Whoops! Something important is missing.", "type": "text"}, {"content": "Maybe next time...", "type": "text"}]}, "type": "feedback"}], "type": "RSLT", "template_override": 1}], "stimuli": [{"_data": [], "type": "welcome", "contents": [{}], "template_override": 1, "id": 0}, {"id": 1, "title": "", "contents": [{"value": {"images": [{"text": "", "id": 0, "time": "0", "image": "engenn7le12ob04re2img01.jpg"}, {"text": "<span class=\"strong\">Sally</span>:         How's your new place in Boston, Peter? Have you settled in yet or are you just getting to know the place?<br/>\n<span class=\"strong\">Peter</span>:        I've settled in, for the most part. My building is very \u2018green' - they have very strict recycling rules. I'm not very knowledgeable when it comes to sorting garbage.", "id": 1, "time": "100", "image": "engenn7le12ob04re2img01.jpg"}, {"text": "<span class=\"strong\">Sally</span>:         Since I've traveled in Europe, I've got quite the knack for knowing what goes where. Recycling is so important for the future of our environment.<br/>\n<span class=\"strong\">Peter</span>:        I know, I know. Sometimes I knowingly throw something that should go in the blue bin down the garbage chute. I just don't have the time!<br/>\n<span class=\"strong\">Sally</span>:         Peter! That's terrible! I think I have a recycling chart in my knapsack. I picked it up at city hall last week. Here, you have it.", "id": 2, "time": "16000", "image": "engenn7le12ob04re2img05.jpg"}, {"text": "<span class=\"strong\">Peter</span>:         Ha, thanks. Next time I just might knock on my neighbor's door and ask ... she's a knockout. <br/>\n<span class=\"strong\">Sally</span>:         Peter, what's more important to you: hitting on your neighbor or saving the narwhal?<br/>\n<span class=\"strong\">Peter</span>:         Narwhal?\n<br/><span class=\"strong\">Sally</span>:         I saw an article yesterday about a narwhal that washed up on the shore with garbage wrapped around its head. It was horrible.<br/>\n<span class=\"strong\">Peter</span>:          Oh, Sally. You're such a tree hugger ... or should I say narwhal hugger?", "id": 3, "time": "42000", "image": "engenn7le12ob04re2img02.jpg"}], "audiosrc": "engenn7le12ob04re2aud01", "coverimg": "engenn7le12ob04re2img01.jpg"}, "type": "slideshow"}], "_data": [], "type": "audio", "template_override": 1}]}]}